{
  "name": "arteyogastudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env --experimental-strip-types --no-warnings scripts/seed-practices.ts",
    "db:seed:journal": "node --env-file=.env --experimental-strip-types --no-warnings scripts/seed-journal.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "role": "node --env-file=.env --experimental-strip-types --no-warnings scripts/set-role.ts",
    "start": "next start",
    "stitch:images": "node --dns-result-order=ipv4first scripts/stitch-images.mjs",
    "stitch:pull": "node --dns-result-order=ipv4first scripts/stitch-pull.mjs",
    "typecheck": "tsc --noEmit",
    "db:seed:programs": "node --env-file=.env --experimental-strip-types --no-warnings scripts/seed-programs.ts",
    "test:cms": "node --experimental-strip-types --test tests/cms.test.mjs",
    "test:cms:db": "node --env-file=.env --experimental-strip-types --no-warnings scripts/check-cms.mjs",
    "db:seed:pages": "node --env-file=.env --experimental-strip-types --no-warnings scripts/seed-pages.ts",
    "db:seed:plans": "node --env-file=.env --experimental-strip-types --no-warnings scripts/seed-plans.ts",
    "db:seed:moderation": "node --env-file=.env --experimental-strip-types --no-warnings scripts/seed-moderation.ts",
    "test:pages": "node --env-file=.env --experimental-strip-types --no-warnings scripts/check-pages.mjs",
    "test:pages:preview": "node --experimental-strip-types --test tests/page-preview.test.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "@better-auth/infra": "^0.4.12",
    "@hookform/resolvers": "^5.9.1",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^15.2.3",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@12.3.4"
}
